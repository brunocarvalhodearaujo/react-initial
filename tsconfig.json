{
  "compilerOptions": {
    "target": "ES6",
    "module": "node16",
    "moduleResolution": "node16",
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true,
    "jsx": "react-jsx",
    "declaration": true,
    "esModuleInterop": true,
    "noUnusedLocals": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "lib": [
      "es2015",
      "esnext",
      "DOM"
    ]
  },
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "node_modules",
    "dist",
    "test"
  ]
}