{
  "name": "react-initial",
  "version": "1.0.15",
  "description": "react component to make Gmail like text avatars for profile pictures",
  "author": "Bruno Carvalho de Araujo <brunocarvalhodearaujo@gmail.com>",
  "license": "MIT",
  "keywords": [
    "react",
    "initial",
    "avatar"
  ],
  "homepage": "https://brunocarvalhodearaujo.github.io/react-initial/",
  "repository": {
    "url": "https://github.com/brunocarvalhodearaujo/react-initial.git",
    "type": "git"
  },
  "bugs": {
    "url": "https://github.com/brunocarvalhodearaujo/react-initial/issues"
  },
  "typings": "dist/index.d.ts",
  "main": "dist/index.js",
  "scripts": {
    "test": "jest --no-cache --coverage",
    "build": "tsc",
    "posttest": "jest-coverage-badges && cp ./coverage/badge-lines.svg ./badge-lines.svg",
    "prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/jest": "25.1.4",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "jest": "^29.7.0",
    "jest-coverage-badges": "^1.1.2",
    "jest-environment-jsdom": "^30.5.1",
    "jest-junit": "^17.0.0",
    "react-test-renderer": "^16.13.0",
    "ts-jest": "^29.4.7",
    "typescript": "^5.9.3",
    "webpack": "4.43.0"
  },
  "peerDependencies": {
    "react": "^16.14.0",
    "react-dom": "^16.14.0"
  },
  "jest": {
    "verbose": true,
    "preset": "ts-jest",
    "testEnvironment": "jest-environment-jsdom",
    "reporters": [
      "default",
      "jest-junit"
    ],
    "coverageReporters": [
      "text-summary",
      "lcov",
      "cobertura",
      "json-summary"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "src/**/*.{js,ts,jsx,tsx}",
      "!src/**/index.{js,ts,jsx,tsx}",
      "!src/**/*.{test,spec}.{js,ts,jsx,tsx}"
    ],
    "testRegex": "(test|src|__test__)/.*\\.(spec|test)\\.(js|ts|jsx|tsx)$",
    "coverageThreshold": {
      "global": {
        "statements": 95,
        "branches": 95,
        "functions": 95,
        "lines": 95
      }
    }
  }
}
